<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ERSCLauncher</AssemblyName>
    <Version>1.8.0</Version>
    <FileVersion>1.8.0.0</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ERSC.Launcher.Core/ERSC.Launcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/**/*.png" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Fonts/*-OFL.txt" />
    <None Update="Assets/Fonts/*-OFL.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
